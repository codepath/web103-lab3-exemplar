# Copy this file to server/.env and fill in the values from your Render
# Postgres instance (Connections section of the database page).
#
# PGHOST is the Hostname plus the region suffix Render shows you. It is not
# always oregon-postgres.render.com — use whichever region your instance is in.

PGDATABASE=""
PGHOST=""
PGPASSWORD=""
PGPORT=5432
PGUSER=""
